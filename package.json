{
  "name": "repoquest",
  "version": "0.1.0",
  "bin": {
    "repoquest": "bin/repoquest.mjs"
  },
  "description": "AI-generated, sandbox-verified learning quests for open-source codebases.",
  "type": "module",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "repoquest": "tsx src/cli.ts",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck"
  },
  "dependencies": {
    "tsx": "^4.19.3",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  }
}
